# ======================================================
# NexusHealth - Environment Variables (.env.example)
# Copy this file to `.env` (repo root). The Spring Boot
# backend loads it automatically for local dev, but real
# environment variables / the Render dashboard always win.
#
# Deployment targets:
#   - Frontend ......... Vercel (vercel.json /api proxy -> Render)
#   - Backend .......... Render (Spring Boot web service)
#   - Database ......... Aiven MySQL (free)
# ======================================================

# --- MySQL Database (local dev defaults) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nexushealth
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password
# On Aiven set these instead:
# MYSQL_SSL_MODE=REQUIRED
# MYSQL_HOST=<aiven-host>.aivencloud.com
# MYSQL_PORT=<aiven-custom-port>
# MYSQL_USER=avnadmin

# --- Gemini AI API (used by AI features) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Backend public URL ---
# Local dev: http://localhost:8080
# Render:    https://<your-service>.onrender.com
APP_URL="http://localhost:8080"

# --- Email / OTP via Brevo (formerly Sendinblue) REST API ---
# Delivers OTP emails over plain HTTPS - no SMTP server or ports needed.
# Get a free key (300 emails/day): https://app.brevo.com/settings/keys/api
# If left empty, OTP emails are disabled and the code is auto-verified.
BREVO_API_KEY="your_brevo_api_key"
# Sender address - must be verified in your Brevo account.
EMAIL_FROM="NexusHealth Identity <ganeswarikuramdasu@gmail.com>"

# --- CORS allowed origins (comma separated) ---
# Local dev:  http://localhost:5173,http://localhost:3000
# Production: add your Vercel app URL, e.g. https://nexus-health-eight.vercel.app
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://nexus-health-eight.vercel.app"

# ======================================================
# DEPLOYMENT-ONLY (set these in Render's dashboard env vars)
# ======================================================
# SUPER_ADMIN_EMAIL=ganeswarikuramdasu@gmail.com
# SUPER_ADMIN_PASSWORD=AnAdminPassword!