# ======================================================
# NexusHealth - Environment Variables (.env.example)
# Copy this file to `.env` and fill in your real values.
# The Spring Boot backend reads these as environment variables,
# falling back to the dev defaults baked into application.yml.
# ======================================================

# --- MySQL Database ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nexushealth
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password

# --- Gemini AI API (used by AI features) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Backend public URL (deployed Render URL) ---
# Used for self-referential links and API endpoints.
APP_URL="http://localhost:8080"

# --- SMTP Mail (optional - OTP / notification emails) ---
# If left empty, no real emails are sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NexusHealth Identity <no-reply@nexushealth.gov.in>"

# --- CORS allowed origins (comma separated) ---
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
