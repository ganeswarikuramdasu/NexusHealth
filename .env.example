# ======================================================
# NexusHealth - Environment Variables (.env.example)
# Copy this file to `.env` and fill in your real values.
# The Spring Boot backend reads these as environment variables,
# falling back to the dev defaults baked into application.yml.
#
# Deployment targets:
#   - Frontend ......... Vercel (VITE_API_BASE_URL / vercel.json proxy)
#   - Backend .......... AWS EC2 (Spring Boot, systemd service)
#   - Database ......... AWS RDS MySQL (free tier)
# ======================================================

# --- MySQL Database (local dev defaults) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nexushealth
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password

# --- Gemini AI API (used by AI features) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Backend public URL ---
# Local dev: http://localhost:8080
# EC2 + ALB (HTTPS): https://<your-alb-dns>
APP_URL="http://localhost:8080"

# --- SMTP Mail (optional - OTP / notification emails) ---
# If left empty, no real emails are sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NexusHealth Identity <no-reply@nexushealth.gov.in>"

# --- CORS allowed origins (comma separated) ---
# Local dev:  http://localhost:5173,http://localhost:3000
# Production: add your Vercel app URL, e.g. https://nexushealth.vercel.app
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ======================================================
# DEPLOYMENT-ONLY (unused in local dev)
# Set these in the EC2 /opt/nexushealth/.env instead.
# ======================================================
# MYSQL_HOST=your-rds-endpoint.rds.amazonaws.com   # RDS endpoint for deployed backend
# SUPER_ADMIN_EMAIL=ganeswarikuramdasu@gmail.com
# SUPER_ADMIN_PASSWORD=AnAdminPassword!
# DEMO_SUPER_ADMIN_EMAIL=demo.admin@nexusdemo.in
# DEMO_SUPER_ADMIN_PASSWORD=DemoAdmin@2026
